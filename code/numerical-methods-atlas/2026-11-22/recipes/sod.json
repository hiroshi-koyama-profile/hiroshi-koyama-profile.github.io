{
  "schema_version": 1,
  "problem_id": "sod",
  "parameters": {
    "coarse_n": 80,
    "fine_n": 160,
    "domain": [
      0,
      1
    ],
    "discontinuity": 0.5,
    "gamma": 1.4,
    "left": [
      1,
      0,
      1
    ],
    "right": [
      0.125,
      0,
      0.1
    ],
    "final_time": 0.2,
    "cfl": 0.3,
    "boundary": "outflow",
    "method": "godunov",
    "riemann": "hllc"
  },
  "acceptance": [
    {
      "id": "riemann-error",
      "metric": "density_l1_error_fine",
      "comparison": "maximum",
      "tolerance": 0.035,
      "description": {
        "ja": "自己相似Riemann解に対する密度L1標本誤差が0.035未満（既存Sod検査と同じ基準）。",
        "en": "Density L1 sample error against the self-similar Riemann solution is at most 0.035, matching the existing Sod-test criterion."
      }
    },
    {
      "id": "refinement",
      "metric": "fine_to_coarse_error_ratio",
      "comparison": "maximum",
      "tolerance": 0.85,
      "description": {
        "ja": "80→160セルで密度誤差が15%以上減る（既存検査の基準）。",
        "en": "Density error decreases by at least 15% from 80 to 160 cells, following the existing test criterion."
      }
    },
    {
      "id": "positive-density",
      "metric": "minimum_density",
      "comparison": "minimum",
      "tolerance": 1e-8,
      "description": {
        "ja": "最小密度が正である。",
        "en": "Minimum density remains positive."
      }
    },
    {
      "id": "positive-pressure",
      "metric": "minimum_pressure",
      "comparison": "minimum",
      "tolerance": 1e-8,
      "description": {
        "ja": "最小圧力が正である。",
        "en": "Minimum gas pressure remains positive."
      }
    },
    {
      "id": "boundary-balance",
      "metric": "physical_boundary_balance_relative_defect",
      "comparison": "maximum",
      "tolerance": 1e-10,
      "description": {
        "ja": "遠方の物理境界流束を差し引いた相対収支誤差。",
        "en": "Relative integral balance defect after subtracting physical far-field boundary fluxes."
      }
    },
    {
      "id": "reached-time",
      "metric": "final_time_error",
      "comparison": "maximum",
      "tolerance": 1e-14,
      "description": {
        "ja": "指定した終端時刻まで進んだ。",
        "en": "The requested final time is reached."
      }
    }
  ]
}
