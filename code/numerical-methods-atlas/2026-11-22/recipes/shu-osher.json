{
  "schema_version": 1,
  "problem_id": "shu-osher",
  "parameters": {
    "coarse_n": 100,
    "fine_n": 200,
    "reference_n": 800,
    "domain": [
      -5,
      5
    ],
    "discontinuity": -4,
    "gamma": 1.4,
    "left": [
      3.857143,
      2.629369,
      10.33333
    ],
    "ambient_density": 1,
    "density_amplitude": 0.2,
    "angular_wavenumber": 5,
    "ambient_velocity": 0,
    "ambient_pressure": 1,
    "final_time": 1.8,
    "cfl": 0.3,
    "boundary": "fixed",
    "method": "weno-z",
    "basis": "characteristic",
    "epsilon": 0.000001
  },
  "acceptance": [
    {
      "id": "numerical-reference-error",
      "metric": "density_l1_error_fine",
      "comparison": "maximum",
      "tolerance": 0.15,
      "description": {
        "ja": "800点の同一手法の数値参照に対する平均密度差が0.15以下。厳密解誤差ではない。",
        "en": "Mean density disagreement with the same-method 800-point numerical reference is at most 0.15; this is not exact-solution error."
      }
    },
    {
      "id": "empirical-refinement",
      "metric": "fine_to_coarse_error_ratio",
      "comparison": "maximum",
      "tolerance": 0.95,
      "description": {
        "ja": "100→200点で高解像度参照との差が減る。収束次数は主張しない。",
        "en": "The discrepancy with the higher-resolution reference decreases from 100 to 200 points; no convergence order is claimed."
      }
    },
    {
      "id": "positive-density",
      "metric": "minimum_density",
      "comparison": "minimum",
      "tolerance": 1e-8,
      "description": {
        "ja": "最小密度が正である。",
        "en": "Minimum density remains positive."
      }
    },
    {
      "id": "positive-pressure",
      "metric": "minimum_pressure",
      "comparison": "minimum",
      "tolerance": 1e-8,
      "description": {
        "ja": "最小圧力が正である。",
        "en": "Minimum gas pressure remains positive."
      }
    },
    {
      "id": "boundary-balance",
      "metric": "physical_boundary_balance_relative_defect",
      "comparison": "maximum",
      "tolerance": 0.002,
      "description": {
        "ja": "物理境界流束に対する近似収支を0.2%以内にする。固定ゴーストのFD境界離散化誤差を含み、丸め誤差保存を主張しない。",
        "en": "Approximate physical-flux balance remains within 0.2%; fixed-ghost FD boundary discretization error is included, so roundoff conservation is not claimed."
      }
    },
    {
      "id": "reached-time",
      "metric": "final_time_error",
      "comparison": "maximum",
      "tolerance": 1e-14,
      "description": {
        "ja": "指定した終端時刻まで進んだ。",
        "en": "The requested final time is reached."
      }
    }
  ]
}
