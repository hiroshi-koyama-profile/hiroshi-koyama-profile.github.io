            "en": "SCF convergence on every mesh"
          },
          "field": "converged",
          "expected": true
        },
        {
          "id": "electron-count",
          "pointer": "/helium/refinement",
          "comparison": "abs_difference",
          "description": {
            "ja": "電子数",
            "en": "Electron number"
          },
          "field": "electron_count",
          "expected": 2,
          "tolerance": 1e-12
        },
        {
          "id": "density-residual",
          "pointer": "/helium/refinement",
          "comparison": "maximum",
          "description": {
            "ja": "入力出力密度のL1残差",
            "en": "Input-output density L1 residual"
          },
          "field": "density_residual",
          "tolerance": 1e-09
        },
        {
          "id": "orbital-residual",
          "pointer": "/helium/refinement",
          "comparison": "maximum",
          "description": {
            "ja": "出力密度での軌道残差",
            "en": "Output-density orbital residual"
          },
          "field": "orbital_residual",
          "tolerance": 1e-07,
          "units": "hartree"
        },
        {
          "id": "energy-identity",
          "pointer": "/helium/refinement",
          "comparison": "maximum",
          "description": {
            "ja": "エネルギー恒等式の誤差",
            "en": "Energy-accounting identity error"
          },
          "field": "energy_identity_error",
          "tolerance": 1e-10,
          "units": "hartree"
        },
        {
          "id": "independent-energy",
          "pointer": "/helium/independent_comparison",
          "comparison": "absolute_maximum",
          "description": {
            "ja": "h²外挿と独立参照の差（誤差の保証ではない）",
            "en": "h²-extrapolated difference from independent references, not a certified bound"
          },
          "field": "extrapolated_reference_difference",
          "tolerance": 1e-08,
          "units": "hartree"
        },
        {
          "id": "independent-density",
          "pointer": "/helium/independent_comparison",
          "comparison": "maximum",
          "description": {
            "ja": "独立参照との密度L1差",
            "en": "Density L1 difference from independent references"
          },
          "field": "radial_density_l1_difference",
          "tolerance": 5e-05
        }
      ],
      "expected_failures": [
